# FarmCredit AI — FastAPI backend
# Copy to backend/.env and fill in values. Never commit .env.

# --- API ---
APP_NAME=FarmCredit AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- XGBoost / SHAP artifacts (relative to repo root) ---
MODEL_DIR=ml/artifacts/model
DEMO_FARMERS_PATH=backend/app/data/demo_farmers.json
DEMO_CACHE_DIR=backend/app/data/demo_cache

# --- HuggingFace / Mistral (private adapter repo) ---
# Replace with your HF username + repo. Required if the repo is private.
HF_MODEL_ID=kavi06/farmcredit-ai-mistral-7b
HF_TOKEN=
HF_BASE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# --- LLM runtime ---
# Set false to serve demo-cache / template advisories only (no GPU/CPU LLM load).
LLM_ENABLED=false
LLM_LOAD_IN_4BIT=true
LLM_EAGER_LOAD=false
LLM_MAX_NEW_TOKENS=320
LLM_TEMPERATURE=0.4

# Demo path: when true, /assess with farmer_id uses precomputed cache by default.
DEMO_USE_CACHE_BY_DEFAULT=true
